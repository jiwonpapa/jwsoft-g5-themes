{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jwsoft.dev/g5-theme/theme-manifest.schema.json",
  "title": "JW SOFT G5 theme manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "name",
    "version",
    "category",
    "support",
    "entries",
    "surfaces",
    "manifests",
    "build",
    "manual"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/themeSlug"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "category": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gnuboard5",
        "php",
        "youngcart"
      ],
      "properties": {
        "gnuboard5": {
          "type": "string",
          "minLength": 1
        },
        "php": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "8.3",
              "8.4",
              "8.5"
            ]
          }
        },
        "youngcart": {
          "enum": [
            "excluded",
            "optional",
            "included"
          ]
        }
      }
    },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "php",
        "css",
        "js"
      ],
      "properties": {
        "php": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/relativePath"
          }
        },
        "css": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/relativePath"
          }
        },
        "js": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/relativePath"
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/slug"
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/slug"
      },
      "default": []
    },
    "workspacePackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^@jwsoft/[a-z0-9-]+$"
      },
      "default": []
    },
    "externalLibraries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets",
        "designReference",
        "release"
      ],
      "properties": {
        "assets": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "designReference": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "release": {
          "$ref": "common.schema.json#/$defs/relativePath"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDir",
        "payloadDir",
        "zipAllowlist"
      ],
      "properties": {
        "sourceDir": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "payloadDir": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "zipAllowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/relativePath"
          }
        }
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "versioned"
      ],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "versioned": {
          "const": true
        }
      }
    }
  }
}
