{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jwsoft.dev/g5-theme/shared-candidates.schema.json",
  "title": "JW SOFT shared code candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "responsibility",
          "themePath",
          "expectedConsumers",
          "gnuboardAssumptions",
          "differences",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "themePath": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "expectedConsumers": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/slug"
            }
          },
          "gnuboardAssumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "differences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "local",
              "candidate",
              "shared",
              "deprecated"
            ]
          },
          "decisionRecord": {
            "$ref": "common.schema.json#/$defs/relativePath"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "shared"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "expectedConsumers": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "common.schema.json#/$defs/slug"
                  }
                },
                "decisionRecord": {
                  "$ref": "common.schema.json#/$defs/relativePath"
                }
              },
              "required": [
                "decisionRecord"
              ]
            }
          }
        ]
      }
    }
  }
}
